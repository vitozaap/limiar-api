# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 17.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Origin of the web client, used as a Better Auth trusted origin. Required.
WEB_ORIGIN=http://localhost:3000

# Sentry DSN for error and performance monitoring. Optional locally; leave empty to disable.
SENTRY_DSN=

# First administrator, created by `npx prisma db seed`. Read only by the seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
