{
  "name": "api",
  "private": true,
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/nestjs-api-reference": "^1.2.14",
    "@sentry/nestjs": "^10.70.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
